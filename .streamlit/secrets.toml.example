# Streamlit Community Cloud Secrets Template
# =========================================================================
# Copy the values below into your Streamlit Cloud app settings under:
# "App Settings" -> "Secrets"
#
# DO NOT commit real tokens or credentials to your Git repository!
# =========================================================================

# 1. Hugging Face Access Token
# Required for downloading the gated base MentalBERT model (mental/mental-bert-base-uncased)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN = "your_huggingface_token_here"

# 2. Hugging Face Model Repository
# The repository where you have uploaded the exported models and artifacts.
# You can use a single repository for everything (HF_MODEL_REPO) or separate ones.
# Example: "your-hf-username/mindtrace-models"
HF_MODEL_REPO = ""
HF_TEXT_MODEL_REPO = ""
HF_ARTIFACTS_REPO = ""

# 3. Optional Direct URLs (Alternative to Hugging Face)
# If you host artifacts on GitHub Releases, S3, or direct CDN:
# FER_MODEL_URL = "https://github.com/.../releases/download/v1.0.0/fer_model.pt"
# FUSION_MODEL_URL = "https://github.com/.../releases/download/v1.0.0/fusion_model.pt"
# BEHAV_SCALER_URL = "https://github.com/.../releases/download/v1.0.0/behav_scaler_esconv.pkl"
# TEXT_MODEL_URL = "https://github.com/.../releases/download/v1.0.0/model.safetensors"
