# MINDTRACE Research Platform Environment Configuration

# Hugging Face Access Token (Required if accessing gated HF repositories)
HF_TOKEN=your_huggingface_token_here

# Local Model Checkpoint Paths (Defaults to models/ and artifacts/)
TEXT_MODEL_PATH=models/text/mentalbert_best_export
FER_MODEL_PATH=models/facial/fer_model.pt
FUSION_MODEL_PATH=models/fusion/fusion_model.pt
BEHAV_SCALER_PATH=artifacts/scalers/behav_scaler_esconv.pkl

# Cloud Hosting Configuration (For Streamlit Community Cloud or remote environments)
# Set your Hugging Face repository containing fine-tuned model and/or artifacts:
# Example: HF_MODEL_REPO=your-hf-username/mindtrace-models
HF_TEXT_MODEL_REPO=
HF_ARTIFACTS_REPO=
HF_MODEL_REPO=

# Optional Direct URLs for artifacts:
FER_MODEL_URL=
FUSION_MODEL_URL=
BEHAV_SCALER_URL=
TEXT_MODEL_URL=

# Application Port
PORT=8501
STREAMLIT_SERVER_HEADLESS=true
